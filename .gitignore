# Secrets & env
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
**/secrets/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
*.egg

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Notebooks
.ipynb_checkpoints/

# Data / artifacts (keep schemas, ignore heavy dumps)
instruments/datasets/**/*.jsonl
instruments/datasets/**/*.parquet
instruments/datasets/**/*.csv
!instruments/datasets/**/.gitkeep
!instruments/datasets/**/README.md
!instruments/datasets/**/schema.md
results/**/*.json
results/**/*.parquet
!results/**/.gitkeep
!results/**/README.md

# Build run dumps (keep README only)
builds/**/results/*.json
builds/**/results/*.jsonl
builds/**/results/*.parquet
builds/**/results/*.costmeter.jsonl
!builds/**/results/.gitkeep
!builds/**/results/README.md

# Content WIP / scratch (do not publish junk to GitHub)
content/**/_wip/

# Caches & OS
.cache/
*.log
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Agent / local tooling
.claude/
.cursor/
.codex/
